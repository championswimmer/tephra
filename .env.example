NODE_ENV=development
HOST=127.0.0.1
PORT=8080
TEPHRA_PUBLIC_URL=http://localhost:8080
TEPHRA_BOOTSTRAP_TOKEN=replace-with-a-one-time-random-token
TEPHRA_DATABASE_DRIVER=sqlite
TEPHRA_SQLITE_PATH=./data/tephra.db
TEPHRA_BLOB_DRIVER=filesystem
TEPHRA_BLOB_PATH=./data/blobs
TEPHRA_MAX_BLOB_BYTES=104857600
TEPHRA_WEB_ROOT=./tephra-server/apps/web/dist

# Official Obsidian Sync is installed at runtime only when first used.
# Keep private state/checkouts on the SAME persistent volume as SQLite/blobs.
TEPHRA_OBSIDIAN_SYNC_ENABLED=true
TEPHRA_OBSIDIAN_SYNC_PATH=./data/obsidian-sync
# Disposable installation cache; automatically rebuilt after eviction/redeploy.
TEPHRA_OBSIDIAN_CACHE_PATH=/tmp/tephra-obsidian-client
TEPHRA_OBSIDIAN_MAX_VAULTS=5
TEPHRA_OBSIDIAN_SCAN_INTERVAL_SECS=2
