{
  // TEMPLATE ONLY — not yet deployable. Copy to wrangler.jsonc at the Worker
  // project root, fill in every <PLACEHOLDER>, and create the D1 database and
  // R2 bucket first. Requires a future Worker entrypoint
  // (e.g. apps/api/src/worker.ts) plus D1/R2 adapters; see README.md.
  // Schema: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tephra",
  "main": "<PATH_TO_WORKER_ENTRYPOINT e.g. ../../apps/api/src/worker.ts>",
  "compatibility_date": "<TODAYS_DATE e.g. 2026-09-06>",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "assets": {
    "directory": "<PATH_TO_WEB_BUILD e.g. ../../apps/web/dist>",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "TEPHRA_PUBLIC_URL": "<HTTPS_PUBLIC_URL>",
    "TEPHRA_ALLOW_SIGNUPS": "false",
    "TEPHRA_DATABASE_DRIVER": "d1",
    "TEPHRA_BLOB_DRIVER": "r2",
    "TEPHRA_MAX_BLOB_BYTES": "104857600",
    "TEPHRA_LOG_LEVEL": "info",
  },
  // Secrets are declared by name only. Set values with:
  //   wrangler secret put TEPHRA_SESSION_SECRET
  //   wrangler secret put TEPHRA_BOOTSTRAP_TOKEN
  // Never commit secret values.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "<D1_DATABASE_NAME>",
      "database_id": "<D1_DATABASE_ID>",
      "preview_database_id": "<D1_PREVIEW_DATABASE_ID>",
      "migrations_dir": "<PATH_TO_MIGRATIONS e.g. ../../apps/api/migrations>",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "<R2_BUCKET_NAME>",
      "preview_bucket_name": "<R2_PREVIEW_BUCKET_NAME>",
    },
  ],
}
