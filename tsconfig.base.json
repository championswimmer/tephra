{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@tephra/protocol": ["tephra-server/packages/protocol/src/index.ts"],
      "@tephra/markdown-editor": ["tephra-server/packages/markdown-editor/src/index.ts"],
      "@tephra/markdown-editor/pure": ["tephra-server/packages/markdown-editor/src/pure.ts"],
      "@tephra/graph-renderer": ["tephra-server/packages/graph-renderer/src/index.ts"],
      "@tephra/graph-renderer/pure": ["tephra-server/packages/graph-renderer/src/pure.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  }
}
