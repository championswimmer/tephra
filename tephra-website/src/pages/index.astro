---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { Icon } from 'astro-icon/components';

const rawBase = import.meta.env.BASE_URL ?? "/";
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

const scenarios = [
  'Your laptop is at home and you need one note.',
  "You're on a work machine where you can't install anything.",
  'You just want to look something up quickly in a browser tab.',
];

const shipped = [
  {
    icon: 'lucide:folder-tree',
    title: 'Your whole vault',
    body: 'Every folder and every note gets synced. No picking and choosing.',
  },
  {
    icon: 'lucide:file-text',
    title: 'Proper rendering',
    body: 'Markdown, frontmatter, tags, callouts and code blocks.',
  },
  {
    icon: 'lucide:link-2',
    title: 'Wikilinks & backlinks',
    body: '[[Links]] work, including links to headings and blocks.',
  },
  {
    icon: 'lucide:waypoints',
    title: 'Graph view',
    body: 'See how your notes connect and click around.',
  },
  {
    icon: 'lucide:image',
    title: 'Attachments',
    body: 'Images and PDFs open right inside the note.',
  },
  {
    icon: 'lucide:moon-star',
    title: 'Light & dark themes',
    body: 'It looks and feels like Obsidian.',
  },
  {
    icon: 'lucide:laptop-minimal-check',
    title: 'Desktop & mobile sync',
    body: 'The plugin works in Obsidian on desktop, iOS and Android.',
  },
  {
    icon: 'lucide:server',
    title: 'Self-hosted',
    body: 'A single container on your own server and domain.',
  },
];

const upcoming = [
  {
    icon: 'lucide:pencil-line',
    title: 'Editing in the browser',
    body: 'Make quick fixes to a note from any computer.',
  },
  {
    icon: 'lucide:refresh-cw',
    title: 'Two-way sync',
    body: "Edits made on the web sync back to your devices, merged properly so nothing gets overwritten.",
  },
  {
    icon: 'lucide:plug-zap',
    title: 'Community plugins',
    body: 'Support for plugins that can run safely in a browser.',
  },
  {
    icon: 'lucide:globe',
    title: 'Optional publishing',
    body: 'Make specific folders public if you want to.',
  },
];

const comparisons = [
  {
    icon: 'lucide:arrow-left-right',
    title: 'Obsidian Sync',
    lead: 'Sync keeps your vault up to date across devices that have Obsidian installed, with version history and shared vaults. It does that really well.',
    verdict: 'Tephra lets you read your vault on devices that don\'t have Obsidian at all.',
  },
  {
    icon: 'lucide:users',
    title: 'Obsidian Publish',
    lead: 'Publish turns notes you choose into a public website, with a custom domain, SEO and analytics. You can password-protect the whole site if you need to.',
    verdict: 'Tephra is just for you: your entire vault, on your own server, behind your own login.',
  },
];
---

<Base
  title="Tephra — your Obsidian vault, in your cloud, from any browser"
  description="Tephra is a self-hosted web app for your Obsidian vault. A plugin syncs your notes to your own server so you can open them from any browser, no Obsidian install needed."
>
  <Nav />

  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="wrap hero-inner">
        <div class="hero-copy">
          <span class="eyebrow">Self-hosted · Open source</span>
          <h1>Your <strong class="obs">Obsidian</strong> vault, <em class="grad">in your cloud</em>, from any browser.</h1>
          <p class="lede">
            Tephra is a web app for your Obsidian vault that you run on your own server. A plugin
            keeps it synced with Obsidian on your devices, so you can open your notes at
            <code>tephra.yourdomain.com</code> from any computer, with links, backlinks and graph
            view working the way you expect.
          </p>
          <div class="cta">
            <a class="btn btn-primary" href="https://github.com/championswimmer/tephra">
              <Icon name="simple-icons:github" size="17" aria-hidden="true" />
              Get started
            </a>
            <a
              class="btn btn-ghost"
              href="https://github.com/championswimmer/tephra/blob/main/docs/GETTING_STARTED.md"
            >
              <Icon name="lucide:book-open" size="17" aria-hidden="true" />
              Read the docs
            </a>
          </div>
          <p class="micro">Self-hosted · Your domain · Your login · AGPL-3.0</p>
        </div>
        <div class="hero-art">
          <img src={`${base}logo-main.svg`} alt="Tephra logo: an ash cloud rising from an obsidian crystal" width="360" height="360" />
        </div>
      </div>
    </section>

    <!-- What it is -->
    <section id="what" class="band">
      <div class="wrap">
        <span class="eyebrow">Why Tephra</span>
        <h2>For when Obsidian isn't within reach.</h2>
        <ul class="scenarios">
          {scenarios.map((line) => <li>{line}</li>)}
        </ul>
        <p class="lede">
          Obsidian stores your vault as plain files on your own devices, which is great until you
          need a note and none of those devices are around. Tephra gives you another way in. It
          doesn't do everything the app does, but it runs on your server and works in any browser.
        </p>
        <div class="flow">
          <div class="step">
            <span class="num"><Icon name="lucide:container" size="18" aria-hidden="true" /></span>
            <h3>Host it yourself</h3>
            <p>Run a single container on your server, on any subdomain you like.</p>
          </div>
          <div class="arrow" aria-hidden="true"><Icon name="lucide:arrow-right" size="22" /></div>
          <div class="step">
            <span class="num"><Icon name="lucide:refresh-cw" size="18" aria-hidden="true" /></span>
            <h3>Install the plugin</h3>
            <p>Add the Tephra plugin to Obsidian on desktop or mobile. It keeps the server up to date.</p>
          </div>
          <div class="arrow" aria-hidden="true"><Icon name="lucide:arrow-right" size="22" /></div>
          <div class="step">
            <span class="num"><Icon name="lucide:app-window" size="18" aria-hidden="true" /></span>
            <h3>Open a browser</h3>
            <p>Log in from any computer and your vault is right there.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Different model -->
    <section id="not">
      <div class="wrap">
        <span class="eyebrow">How it compares</span>
        <h2>How is this different from Sync or Publish?</h2>
        <p class="lede">
          Obsidian already offers two paid services that sound similar. Here's where Tephra fits.
        </p>
        <div class="grid grid-2 not-grid">
          {
            comparisons.map((block) => (
              <article class="card not-card">
                <span class="not-icon"><Icon name={block.icon} size="20" aria-hidden="true" /></span>
                <h3>{block.title}</h3>
                <p class="not-lead">{block.lead}</p>
                <p class="verdict">{block.verdict}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="band">
      <div class="wrap">
        <span class="eyebrow">Features</span>
        <h2>What works today, and what's next.</h2>
        <p class="lede">Tephra covers the parts of Obsidian you need for reading your notes. More is on the way.</p>

        <div class="track track-now">
          <div class="track-head">
            <span class="pill pill-now">Available now</span>
            <span class="track-rule"></span>
          </div>
          <div class="grid grid-4 feat-grid">
            {
              shipped.map((f) => (
                <article class="feat feat-now">
                  <span class="feat-icon">
                    <Icon name={f.icon} size="20" aria-hidden="true" />
                  </span>
                  <h3>{f.title}</h3>
                  <p>{f.body}</p>
                </article>
              ))
            }
          </div>
        </div>

        <div class="track track-soon">
          <div class="track-head">
            <span class="pill pill-soon">Coming soon</span>
            <span class="track-rule"></span>
          </div>
          <div class="grid grid-4 feat-grid">
            {
              upcoming.map((f) => (
                <article class="feat feat-soon">
                  <span class="feat-icon">
                    <Icon name={f.icon} size="20" aria-hidden="true" />
                  </span>
                  <h3>{f.title}</h3>
                  <p>{f.body}</p>
                </article>
              ))
            }
          </div>
        </div>

        <p class="fineprint">
          Right now Tephra supports CommonMark Markdown, YAML frontmatter, headings, tags, Markdown
          links, Obsidian wikilinks (including heading and block links), and image/PDF attachments.
          It doesn't run community plugins, Dataview, Templater, custom JavaScript or custom CSS yet.
        </p>
      </div>
    </section>

    <!-- Etymology -->
    <section id="name" class="etym">
      <div class="wrap etym-inner">
        <div class="etym-art">
          <img src={`${base}logo-main.svg`} alt="" width="220" height="220" />
        </div>
        <div>
          <span class="eyebrow">The name</span>
          <h2>Tephra <span class="ipa">/ˈtɛfrə/</span> <span class="greek" lang="grc">τέφρα</span></h2>
          <p>
            <strong>Tephra</strong> is the ash and rock a volcano throws into the air when it erupts.
            The word comes from the Ancient Greek <em>τέφρα</em>, meaning ash.
          </p>
          <p>
            Obsidian is named after volcanic glass. As its makers put it, if your raw thoughts are
            lava, Obsidian is your crystallised knowledge.
          </p>
          <p>
            Tephra comes from the same eruption, but it's the part that travels. Your vault stays
            where it is, and Tephra carries it far enough that you can read it from anywhere.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="final">
      <div class="wrap final-inner">
        <h2>Take your vault anywhere.</h2>
        <p class="lede">
          Set up the server, install the plugin, and your notes are a browser tab away from any
          computer.
        </p>
        <div class="cta">
          <a class="btn btn-primary" href="https://github.com/championswimmer/tephra">
            <Icon name="simple-icons:github" size="17" aria-hidden="true" />
            Get Tephra on GitHub
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .grad {
    font-style: italic;
    font-weight: 400;
    padding-inline-end: 0.06em;
    background: linear-gradient(120deg, var(--crystal-500), var(--obsidian-900));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .obs {
    font-weight: 700;
  }

  .band {
    background: var(--bg-raised);
    border-block: 1px solid var(--border);
  }

  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(48px, 8vw, 88px);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset-block-start: -280px;
    inset-inline-end: -180px;
    width: 620px;
    height: 620px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--crystal-300), transparent 66%);
    opacity: 0.34;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: grid;
    gap: 40px;
    align-items: center;
  }

  .hero-art {
    display: flex;
    justify-content: center;
  }

  .hero-art img {
    width: min(340px, 74vw);
    height: auto;
    filter: drop-shadow(0 26px 46px rgba(93, 53, 156, 0.28));
    animation: rise 7s ease-in-out infinite;
  }

  @keyframes rise {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-11px);
    }
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .micro {
    font-family: var(--mono);
    letter-spacing: 0.02em;
    margin-top: 18px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  /* Flow */
  .flow {
    display: grid;
    gap: 16px;
    margin-top: 44px;
    align-items: stretch;
  }

  .step {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
    box-shadow: var(--shadow-card);
  }

  .step p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .num {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: var(--accent-soft);
    color: var(--accent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--crystal-400) 35%, transparent);
    margin-bottom: 14px;
  }

  .arrow {
    display: none;
    align-self: center;
    color: var(--crystal-400);
    font-size: 1.5rem;
  }

  @media (min-width: 880px) {
    .flow {
      grid-template-columns: 1fr auto 1fr auto 1fr;
    }
    .arrow {
      display: block;
    }
  }

  /* Scenarios */
  .scenarios {
    list-style: none;
    margin: 0 0 26px;
    padding: 0;
    display: grid;
    gap: 8px;
    max-width: 60ch;
  }

  .scenarios li {
    position: relative;
    padding-inline-start: 26px;
    font-family: var(--display);
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    font-weight: 400;
  }

  .scenarios li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.62em;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--crystal-400);
    transform: rotate(45deg);
  }

  /* Feature tracks */
  .track {
    margin-top: 44px;
  }

  .track-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 22px;
  }

  .track-rule {
    flex: 1;
    height: 1px;
  }

  .track-now .track-rule {
    background: linear-gradient(90deg, var(--crystal-400), transparent);
  }

  .track-soon .track-rule {
    background: repeating-linear-gradient(
      90deg,
      var(--border) 0 7px,
      transparent 7px 14px
    );
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: 8px;
    padding: 7px 14px;
    white-space: nowrap;
  }

  .pill::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  .pill-now {
    background: linear-gradient(135deg, var(--crystal-500), var(--obsidian-900));
    color: #fff;
    box-shadow: 0 8px 20px -12px var(--crystal-700);
  }

  .pill-soon {
    color: var(--text-muted);
    border: 1px dashed var(--crystal-400);
    background: transparent;
  }

  .pill-soon::before {
    background: transparent;
    box-shadow: inset 0 0 0 2px var(--crystal-400);
  }

  /* Feature cards */
  .feat {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    padding: 22px 20px;
    box-shadow: var(--shadow-card);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }

  .feat h3 {
    font-size: 1.02rem;
    margin: 0 0 6px;
  }

  .feat p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .feat-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 9px;
    margin-bottom: 16px;
  }


  /* Now */
  .feat-now {
    background: var(--bg);
    border: 1px solid var(--border);
  }

  .feat-now::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-start: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--crystal-400), var(--obsidian-900));
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  .feat-now:hover {
    transform: translateY(-3px);
    border-color: var(--crystal-400);
    box-shadow: 0 16px 30px -22px var(--obsidian-900);
  }

  .feat-now:hover::after {
    opacity: 1;
  }

  .feat-now .feat-icon {
    background: linear-gradient(135deg, var(--accent-soft), transparent);
    color: var(--accent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--crystal-400) 34%, transparent);
  }

  /* Soon */
  .feat-soon {
    box-shadow: none;
    background: transparent;
    border: 1px dashed color-mix(in srgb, var(--crystal-400) 46%, transparent);
  }

  .feat-soon:hover {
    transform: translateY(-3px);
    border-color: var(--crystal-400);
  }

  .feat-soon h3 {
    color: var(--text-muted);
  }

  .feat-soon .feat-icon {
    background: transparent;
    color: var(--crystal-400);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--crystal-400) 40%, transparent);
  }

  /* Not-grid */
  .not-grid {
    margin-top: 36px;
  }

  .not-card .verdict {
    margin-bottom: 0;
  }

  .not-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 9px;
    margin-bottom: 18px;
    background: var(--accent-soft);
    color: var(--accent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--crystal-400) 35%, transparent);
  }

  .not-card h3 {
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.45rem;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }

  .not-lead {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 16px;
  }

  .verdict {
    margin: 18px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--border);
    font-size: 0.93rem;
    font-weight: 600;
    color: var(--accent);
  }

  .not-card ul {
    margin: 0;
    padding-inline-start: 20px;
    display: grid;
    gap: 12px;
  }

  .not-card li {
    color: var(--text-muted);
    font-size: 0.97rem;
  }

  .not-card li::marker {
    color: var(--crystal-400);
  }

  /* Features */
  .fineprint {
    margin-top: 30px;
    font-size: 0.88rem;
    color: var(--text-muted);
    max-width: 78ch;
  }

  /* Etymology */
  .etym {
    position: relative;
    background:
      radial-gradient(120% 90% at 22% 12%, rgba(116, 72, 185, 0.28), transparent 62%),
      linear-gradient(165deg, #0b0614 0%, #170e28 46%, var(--obsidian-950) 100%);
    color: #efe7fb;
  }

  .etym h2,
  .etym strong {
    color: #fff;
  }

  .etym p {
    color: #d5c6ee;
    max-width: 60ch;
  }

  .etym .eyebrow {
    background: rgba(255, 255, 255, 0.12);
    color: var(--crystal-200);
  }

  .greek {
    display: block;
    margin-top: 6px;
    font-style: italic;
    font-weight: 400;
    font-size: 0.55em;
    color: var(--crystal-300);
  }

  .ipa {
    font-family: var(--mono);
    font-weight: 400;
    font-size: 0.34em;
    vertical-align: middle;
    color: var(--crystal-200);
    letter-spacing: 0;
  }

  .etym-inner {
    display: grid;
    gap: 36px;
    align-items: center;
  }

  .etym-art {
    display: flex;
    justify-content: center;
  }

  .etym-art img {
    width: min(220px, 52vw);
    height: auto;
    opacity: 0.95;
  }

  @media (min-width: 900px) {
    .etym-inner {
      grid-template-columns: 0.4fr 1fr;
    }
  }

  /* Final CTA */
  .final-inner {
    text-align: center;
    display: grid;
    justify-items: center;
  }

  .final-inner .cta {
    justify-content: center;
  }
</style>
