---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const rawBase = import.meta.env.BASE_URL ?? "/";
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

const scenarios = [
  'Your laptop is at home.',
  'You are on a machine that will never have Obsidian installed.',
  'You just want to look something up, right now, from a browser.',
];

const shipped = [
  {
    icon: 'tree',
    title: 'Your whole vault',
    body: 'Every folder, every note. Nothing to curate.',
  },
  {
    icon: 'doc',
    title: 'Notes, rendered',
    body: 'Markdown, frontmatter, tags, callouts, code.',
  },
  {
    icon: 'link',
    title: 'Wikilinks & backlinks',
    body: '[[Links]] resolve, down to headings and blocks.',
  },
  {
    icon: 'graph',
    title: 'Graph view',
    body: 'Your link structure, laid out and clickable.',
  },
  {
    icon: 'image',
    title: 'Attachments',
    body: 'Images and PDFs open inline.',
  },
  {
    icon: 'moon',
    title: 'Light & dark themes',
    body: 'Looks like Obsidian, not a file listing.',
  },
  {
    icon: 'devices',
    title: 'Desktop & mobile sync',
    body: 'The plugin runs on every Obsidian platform.',
  },
  {
    icon: 'server',
    title: 'Self-hosted',
    body: 'One container. Your domain, your login.',
  },
];

const upcoming = [
  {
    icon: 'pencil',
    title: 'Editing in the browser',
    body: 'Fix a note from a machine that is not yours.',
  },
  {
    icon: 'sync',
    title: 'Two-way sync',
    body: 'Web edits flow home. Three-way merge, no silent overwrites.',
  },
  {
    icon: 'plug',
    title: 'Community plugins',
    body: 'A browser-safe subset of the ecosystem.',
  },
  {
    icon: 'globe',
    title: 'Optional publishing',
    body: 'Opt in, one subtree at a time.',
  },
];

const icons: Record<string, string> = {
  tree: '<path d="M3 8a2 2 0 0 1 2-2h3.4l1.8 2H19a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="M7 13h7M7 16h4"/>',
  doc: '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 12h6M9 16h4"/>',
  link: '<path d="M10 13a4 4 0 0 0 6 .5l2-2a4 4 0 0 0-6-6l-1 1"/><path d="M14 11a4 4 0 0 0-6-.5l-2 2a4 4 0 0 0 6 6l1-1"/>',
  graph: '<circle cx="6" cy="7" r="2.4"/><circle cx="18" cy="9" r="2.4"/><circle cx="11" cy="18" r="2.4"/><path d="M8 8.5 16 9M7.5 9.5 10 15.7M16.7 11 12.6 16.3"/>',
  image: '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10" r="1.5"/><path d="m4 17 5-4 4 3 3-2 4 3"/>',
  moon: '<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/>',
  devices: '<rect x="2" y="5" width="13" height="10" rx="1.5"/><rect x="16" y="9" width="6" height="11" rx="1.5"/><path d="M6 19h5"/>',
  server: '<rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/>',
  pencil: '<path d="M4 20h4L19.5 8.5a2.1 2.1 0 0 0-3-3L5 17v3Z"/><path d="m14.5 6.5 3 3"/>',
  sync: '<path d="M4 11a8 8 0 0 1 13.5-5.5L20 8"/><path d="M20 4v4h-4"/><path d="M20 13a8 8 0 0 1-13.5 5.5L4 16"/><path d="M4 20v-4h4"/>',
  plug: '<path d="M9 3v6M15 3v6"/><path d="M7 9h10v3a5 5 0 0 1-10 0Z"/><path d="M12 17v4"/>',
  globe: '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.5 3 2.5 14 0 17M12 3.5c-2.5 3-2.5 14 0 17"/>',
};

const comparisons = [
  {
    title: 'Obsidian Sync moves files',
    lead: 'Sync keeps vaults in step across devices — both directions, with version history, selective sync of settings and plugins, and shared vaults. It assumes you already have Obsidian open on each end.',
    verdict: 'Tephra is the end. It is a client, not a pipe — reachable from a machine that has no Obsidian at all.',
  },
  {
    title: 'Obsidian Publish is for other people',
    lead: 'Publish takes notes you pick and puts them on the open web with a custom domain, SEO and analytics — or one site-wide password if you want the whole thing closed.',
    verdict: 'Tephra is for you. The whole vault, on your infra, behind your login. There is no public mode to switch on.',
  },
];
---

<Base
  title="Tephra — a lightweight Obsidian in the cloud"
  description="Tephra is a self-hosted, Obsidian-compatible client that runs on your own infrastructure. Sync it with your Obsidian instances and open your whole vault from any browser — no laptop, no app install required."
>
  <Nav />

  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="wrap hero-inner">
        <div class="hero-copy">
          <span class="eyebrow">Obsidian, minus the install</span>
          <h1>A lightweight <span class="grad">Obsidian</span>, running in the cloud.</h1>
          <p class="lede">
            Tephra is an Obsidian-compatible client you host on your own infrastructure. It syncs
            with your Obsidian instances, then serves your whole vault at
            <code>tephra.yourdomain.com</code> — as if a copy of the app were running on your server,
            waiting in a browser tab.
          </p>
          <div class="cta">
            <a class="btn btn-primary" href="https://github.com/championswimmer/tephra">
              Get started
            </a>
            <a
              class="btn btn-ghost"
              href="https://github.com/championswimmer/tephra/blob/main/docs/GETTING_STARTED.md"
            >
              Read the docs
            </a>
          </div>
          <p class="micro">Self-hosted · Your domain · Your login · AGPL-3.0</p>
        </div>
        <div class="hero-art">
          <img src={`${base}logo-main.svg`} alt="Tephra logo: an ash cloud rising from an obsidian crystal" width="360" height="360" />
        </div>
      </div>
    </section>

    <!-- What it is -->
    <section id="what" class="band">
      <div class="wrap">
        <span class="eyebrow">What it is for</span>
        <h2>For when the app is not where you are.</h2>
        <ul class="scenarios">
          {scenarios.map((line) => <li>{line}</li>)}
        </ul>
        <p class="lede">
          Obsidian is a desktop app, and a vault is a folder on a disk. That is the whole point of
          it — right up until you are not at that disk. Tephra is a second client for the same
          vault: fewer features than the real app, but it lives on a server you own and opens in
          any browser you can find.
        </p>
        <div class="flow">
          <div class="step">
            <span class="num">1</span>
            <h3>Host it yourself</h3>
            <p>One container on your own infra, on a subdomain you pick.</p>
          </div>
          <div class="arrow" aria-hidden="true">→</div>
          <div class="step">
            <span class="num">2</span>
            <h3>Sync your instances</h3>
            <p>The plugin runs in Obsidian on desktop and mobile and keeps Tephra current.</p>
          </div>
          <div class="arrow" aria-hidden="true">→</div>
          <div class="step">
            <span class="num">3</span>
            <h3>Open a browser</h3>
            <p>Log in from any machine and your vault is there — links, graph and all.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Different model -->
    <section id="not">
      <div class="wrap">
        <span class="eyebrow">A different model</span>
        <h2>Why this is not Sync, and not Publish.</h2>
        <p class="lede">
          Obsidian sells two services that sound adjacent to this. Both solve a different problem.
        </p>
        <div class="grid grid-2 not-grid">
          {
            comparisons.map((block) => (
              <article class="card not-card">
                <h3>{block.title}</h3>
                <p class="not-lead">{block.lead}</p>
                <p class="verdict">{block.verdict}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="band">
      <div class="wrap">
        <span class="eyebrow">Features</span>
        <h2>A subset of Obsidian, honestly labelled.</h2>
        <p class="lede">Exactly what it does today, and exactly what is coming.</p>

        <div class="track track-now">
          <div class="track-head">
            <span class="pill pill-now">Available now</span>
            <span class="track-rule"></span>
          </div>
          <div class="grid grid-4 feat-grid">
            {
              shipped.map((f) => (
                <article class="feat feat-now">
                  <span class="feat-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[f.icon]} />
                  </span>
                  <h3>{f.title}</h3>
                  <p>{f.body}</p>
                </article>
              ))
            }
          </div>
        </div>

        <div class="track track-soon">
          <div class="track-head">
            <span class="pill pill-soon">On the horizon</span>
            <span class="track-rule"></span>
          </div>
          <div class="grid grid-4 feat-grid">
            {
              upcoming.map((f) => (
                <article class="feat feat-soon">
                  <span class="feat-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[f.icon]} />
                  </span>
                  <h3>{f.title}</h3>
                  <p>{f.body}</p>
                </article>
              ))
            }
          </div>
        </div>

        <p class="fineprint">
          Today Tephra renders CommonMark Markdown, YAML frontmatter, headings, tags, Markdown
          links, Obsidian wikilinks, heading and block subpaths, and image/PDF attachments. It does
          not yet run community plugins, Dataview, Templater, custom JavaScript, or custom CSS.
        </p>
      </div>
    </section>

    <!-- Etymology -->
    <section id="name" class="etym">
      <div class="wrap etym-inner">
        <div class="etym-art">
          <img src={`${base}logo-main.svg`} alt="" width="220" height="220" />
        </div>
        <div>
          <span class="eyebrow">The name</span>
          <h2>Tephra <span class="ipa">/ˈtɛfrə/</span></h2>
          <p>
            <strong>Tephra</strong> is the ash a volcano throws skyward — from the Ancient Greek
            <em>τέφρα</em>. The cloud above the mountain.
          </p>
          <p>
            Obsidian's makers named their app after volcanic glass, with a metaphor they put
            plainly: if your raw thoughts are lava, Obsidian is your crystallised knowledge.
          </p>
          <p>
            Same eruption, the part that travels. Your vault is the rock; Tephra is the cloud it
            throws — far enough to read from anywhere.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="final">
      <div class="wrap final-inner">
        <h2>Put an Obsidian on your own server.</h2>
        <p class="lede">
          One container, one plugin, one login — and your vault is waiting at your own domain, on
          whatever machine you happen to be sitting at.
        </p>
        <div class="cta">
          <a class="btn btn-primary" href="https://github.com/championswimmer/tephra">
            Get Tephra on GitHub
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .grad {
    background: linear-gradient(120deg, var(--crystal-500), var(--obsidian-900));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .band {
    background: var(--bg-raised);
    border-block: 1px solid var(--border);
  }

  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(48px, 8vw, 88px);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset-block-start: -280px;
    inset-inline-end: -180px;
    width: 620px;
    height: 620px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--crystal-300), transparent 66%);
    opacity: 0.34;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: grid;
    gap: 40px;
    align-items: center;
  }

  .hero-art {
    display: flex;
    justify-content: center;
  }

  .hero-art img {
    width: min(340px, 74vw);
    height: auto;
    filter: drop-shadow(0 26px 46px rgba(93, 53, 156, 0.28));
    animation: rise 7s ease-in-out infinite;
  }

  @keyframes rise {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-11px);
    }
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .micro {
    margin-top: 18px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  /* Flow */
  .flow {
    display: grid;
    gap: 16px;
    margin-top: 44px;
    align-items: stretch;
  }

  .step {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
  }

  .step p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .num {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 700;
    font-size: 0.85rem;
    margin-bottom: 12px;
  }

  .arrow {
    display: none;
    align-self: center;
    color: var(--crystal-400);
    font-size: 1.5rem;
  }

  @media (min-width: 880px) {
    .flow {
      grid-template-columns: 1fr auto 1fr auto 1fr;
    }
    .arrow {
      display: block;
    }
  }

  /* Scenarios */
  .scenarios {
    list-style: none;
    margin: 0 0 26px;
    padding: 0;
    display: grid;
    gap: 8px;
    max-width: 60ch;
  }

  .scenarios li {
    position: relative;
    padding-inline-start: 26px;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    font-weight: 600;
  }

  .scenarios li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.62em;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--crystal-400);
    transform: rotate(45deg);
  }

  /* Feature tracks */
  .track {
    margin-top: 44px;
  }

  .track-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 22px;
  }

  .track-rule {
    flex: 1;
    height: 1px;
  }

  .track-now .track-rule {
    background: linear-gradient(90deg, var(--crystal-400), transparent);
  }

  .track-soon .track-rule {
    background: repeating-linear-gradient(
      90deg,
      var(--border) 0 7px,
      transparent 7px 14px
    );
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 8px 18px;
    white-space: nowrap;
  }

  .pill::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  .pill-now {
    background: linear-gradient(135deg, var(--crystal-500), var(--obsidian-900));
    color: #fff;
    box-shadow: 0 8px 20px -12px var(--crystal-700);
  }

  .pill-soon {
    color: var(--text-muted);
    border: 1px dashed var(--crystal-400);
    background: transparent;
  }

  .pill-soon::before {
    background: transparent;
    box-shadow: inset 0 0 0 2px var(--crystal-400);
  }

  /* Feature cards */
  .feat {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    padding: 22px 20px;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }

  .feat h3 {
    font-size: 1.02rem;
    margin: 0 0 6px;
  }

  .feat p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .feat-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    margin-bottom: 14px;
  }

  .feat-icon svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Now */
  .feat-now {
    background: var(--bg);
    border: 1px solid var(--border);
  }

  .feat-now::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-start: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--crystal-400), var(--obsidian-900));
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  .feat-now:hover {
    transform: translateY(-3px);
    border-color: var(--crystal-400);
    box-shadow: 0 16px 30px -22px var(--obsidian-900);
  }

  .feat-now:hover::after {
    opacity: 1;
  }

  .feat-now .feat-icon {
    background: linear-gradient(135deg, var(--accent-soft), transparent);
    color: var(--accent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--crystal-400) 34%, transparent);
  }

  .feat-now .feat-icon svg {
    stroke: currentColor;
  }

  /* Soon */
  .feat-soon {
    background: transparent;
    border: 1px dashed color-mix(in srgb, var(--crystal-400) 46%, transparent);
  }

  .feat-soon:hover {
    transform: translateY(-3px);
    border-color: var(--crystal-400);
  }

  .feat-soon h3 {
    color: var(--text-muted);
  }

  .feat-soon .feat-icon {
    background: transparent;
    color: var(--crystal-400);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--crystal-400) 40%, transparent);
  }

  .feat-soon .feat-icon svg {
    stroke: currentColor;
    stroke-dasharray: 3 2.4;
  }

  /* Not-grid */
  .not-grid {
    margin-top: 36px;
  }

  .not-card .verdict {
    margin-bottom: 0;
  }

  .not-card {
    border-inline-start: 4px solid var(--crystal-400);
  }

  .not-card h3 {
    font-size: 1.3rem;
    margin-bottom: 10px;
  }

  .not-lead {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 16px;
  }

  .verdict {
    margin: 18px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--border);
    font-size: 0.93rem;
    font-weight: 600;
    color: var(--accent);
  }

  .not-card ul {
    margin: 0;
    padding-inline-start: 20px;
    display: grid;
    gap: 12px;
  }

  .not-card li {
    color: var(--text-muted);
    font-size: 0.97rem;
  }

  .not-card li::marker {
    color: var(--crystal-400);
  }

  /* Features */
  .fineprint {
    margin-top: 30px;
    font-size: 0.88rem;
    color: var(--text-muted);
    max-width: 78ch;
  }

  /* Etymology */
  .etym {
    position: relative;
    background:
      radial-gradient(120% 90% at 22% 12%, rgba(116, 72, 185, 0.28), transparent 62%),
      linear-gradient(165deg, #0b0614 0%, #170e28 46%, var(--obsidian-950) 100%);
    color: #efe7fb;
  }

  .etym h2,
  .etym strong {
    color: #fff;
  }

  .etym p {
    color: #d5c6ee;
    max-width: 60ch;
  }

  .etym .eyebrow {
    background: rgba(255, 255, 255, 0.12);
    color: var(--crystal-200);
  }

  .ipa {
    font-weight: 400;
    font-size: 0.5em;
    color: var(--crystal-200);
    letter-spacing: 0;
  }

  .etym-inner {
    display: grid;
    gap: 36px;
    align-items: center;
  }

  .etym-art {
    display: flex;
    justify-content: center;
  }

  .etym-art img {
    width: min(220px, 52vw);
    height: auto;
    opacity: 0.95;
  }

  @media (min-width: 900px) {
    .etym-inner {
      grid-template-columns: 0.4fr 1fr;
    }
  }

  /* Final CTA */
  .final-inner {
    text-align: center;
    display: grid;
    justify-items: center;
  }

  .final-inner .cta {
    justify-content: center;
  }
</style>
