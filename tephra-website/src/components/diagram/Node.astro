---
// A single box in an InfraDiagram. `stack` puts the icon above the text; `row` puts it beside.
import { Icon } from 'astro-icon/components';

interface Props {
  x: number;
  y: number;
  w: number;
  h: number;
  icon: string;
  title: string;
  sub: string;
  layout?: 'stack' | 'row';
}

const { x, y, w, h, icon, title, sub, layout = 'stack' } = Astro.props;
const cx = x + w / 2;
---

<g class="node">
  <rect class="card" x={x} y={y} width={w} height={h} rx="16" />
  {
    layout === 'stack' ? (
      <>
        <rect class="tile" x={cx - 16} y={y + 14} width="32" height="32" rx="9" />
        <g class="ic">
          <Icon name={icon} x={cx - 9} y={y + 21} width="18" height="18" />
        </g>
        <text class="t" x={cx} y={y + 64} text-anchor="middle">{title}</text>
        <text class="s" x={cx} y={y + 80} text-anchor="middle">{sub}</text>
      </>
    ) : (
      <>
        <rect class="tile" x={x + 14} y={y + h / 2 - 16} width="32" height="32" rx="9" />
        <g class="ic">
          <Icon name={icon} x={x + 21} y={y + h / 2 - 9} width="18" height="18" />
        </g>
        <text class="t" x={x + 58} y={y + h / 2 - 2}>{title}</text>
        <text class="s" x={x + 58} y={y + h / 2 + 15}>{sub}</text>
      </>
    )
  }
</g>

<style>
  .card {
    fill: var(--bg-raised);
    stroke: var(--border);
    stroke-width: 1.2;
    filter: drop-shadow(0 10px 14px rgba(42, 27, 69, 0.1));
  }

  .tile {
    fill: var(--accent-soft);
    stroke: color-mix(in srgb, var(--crystal-400) 38%, transparent);
  }

  .ic {
    color: var(--accent);
  }

  .t {
    fill: var(--text);
    font-family: var(--font);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .s {
    fill: var(--text-muted);
    font-family: var(--mono);
    font-size: 10.5px;
  }

  .node {
    transition: transform 0.2s ease;
  }
</style>
