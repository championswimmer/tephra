{
  "name": "tephra",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "tephra-server/apps/*",
    "tephra-server/packages/*",
    "tephra-server/packages/database/*",
    "tephra-server/packages/blob-store/*",
    "tephra-plugin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace=@tephra/api",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test": "npm run build && npm run test:workspaces",
    "sync:vault": "node e2e/sync-vault.mjs",
    "sync:plugin": "node scripts/sync-plugin.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:workspaces"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
